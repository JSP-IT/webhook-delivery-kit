<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code: relax rules that target shipped library APIs. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861;CA2007;CA1849;CA5394;CA1062;CA2000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real Kestrel endpoints on loopback act as mock webhook receivers. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/JspIt.WebhookDelivery/JspIt.WebhookDelivery.csproj" />
    <ProjectReference Include="../../src/JspIt.WebhookDelivery.Sqlite/JspIt.WebhookDelivery.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
